# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.

# Supabase (safe to expose in frontend — these are public keys)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# GEMINI_API_KEY must ONLY be set in Supabase Edge Function Secrets.
# Do NOT add it here — the VITE_ prefix would expose it in the public JS bundle.
# Set it at: supabase.com/dashboard/project/YOUR_PROJECT/settings/functions

# ── Cloudflare R2 (asset storage) — used only by scripts/upload-r2.mjs ──
# No VITE_ prefix: server-side only, never bundled.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="octadezx"
R2_PUBLIC_BASE="https://cdn.octadezx.com"
