# Voice media server. Set these with `fly secrets set KEY=value`.
# Nothing here belongs in the Docker image or in git.

# This app's own https origin. The TeXML application's Voice URL must point at
# <PUBLIC_URL>/texml/inbound, and the media stream URL is built from this too.
PUBLIC_URL=https://octadezx-voice.fly.dev

SUPABASE_URL=https://dnjhvfmlmvhabrlpcmao.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret that ai-voice-turn checks. Generate with: openssl rand -hex 32
VOICE_SERVER_SECRET=

# Telnyx webhook signing key, from Mission Control under the API keys page.
# This is a PUBLIC key: it verifies signatures and cannot create them, so this
# server holds no Telnyx credential and cannot place calls on the account.
TELNYX_PUBLIC_KEY=
# Only ever set this to false on a local machine.
TELNYX_VALIDATE_SIGNATURES=true

# One key covers both speech to text and text to speech.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# Largest single lever on perceived latency. Lower is snappier but clips people
# who pause mid-sentence.
DEEPGRAM_ENDPOINTING_MS=250
DEEPGRAM_UTTERANCE_END_MS=1000

TTS_PROVIDER=deepgram
TTS_VOICE=aura-2-thalia-en

# Fallback provider only. Leave blank unless you want Google as a backup.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-F

MAX_CALL_SECONDS=900
NO_INPUT_MS=7000
MAX_CONCURRENT_TTS=40
